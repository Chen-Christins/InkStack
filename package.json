{
  "name": "techhaven",
  "private": true,
  "version": "1.1.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "build:test": "tsc --noEmit -p tsconfig.build.json && vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run",
    "check:i18n": "vitest run src/i18n/I18n.test.ts",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "check:agent-contract": "node scripts/check-agent-contract.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "hashids": "^2.3.0",
    "i18next": "^26.5.4",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "simplebar": "^6.3.3",
    "simplebar-react": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
